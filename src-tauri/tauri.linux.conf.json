{
  "app": {
    "security": {
      "capabilities": [
        "desktop",
        "system-monitor-window",
        "log-app-window",
        "logs-window"
      ]
    }
  },
  "bundle": {
    "targets": ["deb", "appimage", "rpm"],
    "resources": ["resources/pre-install/**/*", "resources/LICENSE"],
    "externalBin": ["resources/bin/uv", "resources/bin/bun"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {
          "usr/bin/bun": "resources/bin/bun",
          "usr/bin/uv": "resources/bin/uv"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "files": {
          "/usr/bin/bun": "resources/bin/bun",
          "/usr/bin/uv": "resources/bin/uv"
        }
      }
    }
  }
}
